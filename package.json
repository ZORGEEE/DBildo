{
  "name": "dbildo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,ui -c blue,magenta \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:desktop": "concurrently -k -n server,ui,desktop -c blue,magenta,green \"npm:dev:server\" \"npm:dev:ui\" \"wait-on http://127.0.0.1:5173 http://127.0.0.1:4317/health && DBILDO_DEV=1 electron apps/desktop/main.cjs\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start:server": "tsx apps/server/src/index.ts",
    "start:desktop": "electron apps/desktop/main.cjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:harness": "node scripts/check-harness.mjs",
    "infra:up": "node scripts/publish-dev.mjs && docker compose -f infra/dev/compose.yaml up -d --build",
    "infra:down": "docker compose -f infra/dev/compose.yaml down"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.2.0-rc.2",
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.9.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "concurrently": "^9.2.0",
    "electron": "^38.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wait-on": "^8.0.0"
  }
}
